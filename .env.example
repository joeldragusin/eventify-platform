# Copy this file to ".env" (which is gitignored) and fill in real values.
# NOTE: if the postgres_data volume already exists, POSTGRES_PASSWORD must match
# the old password (1234) or you must recreate the volume: docker compose down -v
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
