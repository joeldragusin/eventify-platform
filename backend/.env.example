# Copy this file to "backend/.env" (gitignored) to run the backend OUTSIDE Docker.
# Inside Docker these values come from docker-compose.yml and the root .env.

# Host port 5433 is the Postgres container published by docker-compose.
# Use the same password as POSTGRES_PASSWORD in the root .env.
DATABASE_URL="postgresql://postgres:change-me@localhost:5433/eventify?schema=public"

# Any long random string (e.g. run: openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="14d"

# Origin allowed by CORS: the address where the frontend is served.
FRONTEND_URL=http://localhost:5173
