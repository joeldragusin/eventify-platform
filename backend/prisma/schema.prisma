//this is the file which defines the postgresql database structure of my application EventUp
//here we define models (their name in Prisma) which are equivalent to tables in sql

//the assmebly instruction itself, meaning this is the command that initiates the ORM as a layer between the db
//and the backend component
generator client {
  provider = "prisma-client-js"
}

//this is the direct config and the conn link is loaded from .env in order to avoid sharing sensitive data here
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//this is an enumeration defining all roles possible in my application
enum Role {
  USER
  EVENT_PLANNER
  ADMIN
}

//table User (it is for all logged in users)
model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //here i defined the relations
  Event     Event[] //these are events created by the user
  orders    Order[] //these are orders created by the user
  reviews   Review[] //these are reviews created by the user
}

//table for events created in EventUp
model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  time        String
  capacity    Int
  price       Float
  image       String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //Relation to the event planner
  planner   User @relation(fields: [plannerId], references: [id])
  plannerId Int

  //Relation to a venue
  venue   Venue? @relation(fields: [venueId], references: [id])
  venueId Int?

  tickets Ticket[] //tickets related to a specific event
  reviews Review[] //reviews related to an specific event
}

//table for venues (=locations)
model Venue {
  id      Int    @id @default(autoincrement())
  name    String
  address String

  events Event[] //the existing events within this location
}

//once again, an enumeration
//it describes all possible states for an order
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

//ticket table for an event
model Ticket {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relation to its event
  event   Event @relation(fields: [eventId], references: [id])
  eventId Int

  //Relation to OrderItem
  orderItems OrderItem[] //orderitems pointing to this ticket
  Review     Review[] //reviews related to this ticket
}

//table Order
model Order {
  id        Int         @id @default(autoincrement())
  total     Float
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  //Relation to User who created/place the order
  user   User @relation(fields: [userId], references: [id])
  userId Int

  //Relation to OrderItems
  orderItems OrderItem[]
}

//only available orders are tickets
//therefore it represents the ordered ticket
model OrderItem {
  id        Int   @id @default(autoincrement())
  quantity  Int
  unitPrice Float

  //Relation to Order
  order   Order @relation(fields: [orderId], references: [id])
  orderId Int

  //Relation to Ticket
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  ticketId Int
}

//reviews table
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  //relation to the author of the review
  user   User @relation(fields: [userId], references: [id])
  userId Int

  //relation to the ticket which is optional
  ticket   Ticket? @relation(fields: [ticketId], references: [id])
  ticketId Int?

  //also an optional relation, but to an event
  event   Event? @relation(fields: [eventId], references: [id])
  eventId Int?
}

//the testimonials table, for "marketing" purposes
model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  roleLabel String?
  message   String
  rating    Int?
  createdAt DateTime @default(now())
}
